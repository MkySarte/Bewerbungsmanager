<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/>
    </parent>

    <groupId>de.mkysarte</groupId>
    <artifactId>bewerbungsmanager-desktop</artifactId>
    <version>1.1.0</version>
    <name>Bewerbungsmanager Desktop</name>
    <description>Lokale Desktop-Anwendung zur Bewerbungsverwaltung (JavaFX + Spring Boot + SQLite)</description>

    <properties>
        <java.version>21</java.version>
        <javafx.version>21.0.5</javafx.version>
        <main.class>de.mkysarte.bewerbungsmanager.BewerbungsmanagerApp</main.class>
    </properties>

    <dependencies>
        <!-- ===== Spring Boot Core ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== SQLite mit SQLCipher (Local-First, verschluesselt) =====
             Fork von org.xerial:sqlite-jdbc mit wxSQLite3/Multiple-Ciphers.
             Bringt die nativen Bibliotheken fuer Windows, macOS und Linux
             (x86_64 + aarch64) mit, daher laeuft der Installer ohne Nachladen. -->
        <dependency>
            <groupId>io.github.willena</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>6.6.4.Final</version>
        </dependency>

        <!-- ===== JavaFX 21 ===== -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ===== Ikonli (FontAwesome 5 icons) ===== -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>12.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-fontawesome5-pack</artifactId>
            <version>12.3.1</version>
        </dependency>

        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.4</version>
        </dependency>

        <!-- ===== Lombok ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== Dev Tools ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ===== Test ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lombok Annotation Processing -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Spring Boot Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <!-- classifier=exec: Fat-JAR bekommt -exec-Suffix, das Thin-JAR
                         bleibt das Hauptartefakt (bewerbungsmanager-desktop-1.0.0.jar).
                         jpackage kann dann direkt mit dem normalen Classpath-Layout arbeiten. -->
                    <classifier>exec</classifier>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- JavaFX Plugin (für mvn javafx:run in der Entwicklung) -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <!-- Abhängigkeiten in target/libs kopieren (für jpackage) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Haupt-JAR nach target/libs/ kopieren (nach spring-boot:repackage, für jpackage) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-app-jar-to-libs</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <!-- Thin-JAR der Hauptanwendung -->
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="${project.build.directory}/libs"
                                      overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- jpackage Plugin für native Installer -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.5</version>
                <configuration>
                    <name>Bewerbungsmanager</name>
                    <appVersion>${project.version}</appVersion>
                    <vendor>mkysarte</vendor>
                    <!-- Erscheint in den Dateieigenschaften und unter "Apps und Features".
                         Ohne diese Angaben steht dort nur der nackte Name. -->
                    <description>${project.description}</description>
                    <copyright>(c) 2026 mkysarte</copyright>
                    <aboutUrl>https://github.com/MkySarte/Bewerbungsmanager</aboutUrl>
                    <!-- Wird beim Einrichten angezeigt. Der Pfad ist absolut, weil jpackage
                         aus target/ heraus arbeitet und die CI vor dem Bauen versions:set
                         auf diese Datei laufen laesst. -->
                    <licenseFile>${project.basedir}/LICENSE.md</licenseFile>
                    <destination>${project.build.directory}/installer</destination>
                    <input>${project.build.directory}/libs</input>
                    <mainJar>${project.build.finalName}.jar</mainJar>
                    <mainClass>${main.class}</mainClass>
                    <!-- JavaFX ist kein JDK-Bestandteil: jlink braucht modulePath + addModules.
                         jdk.unsupported: für Spring Boot (sun.misc.Unsafe).
                         Alle anderen JDK-Module zieht jlink transitiv von javafx.graphics. -->
                    <modulePaths>
                        <modulePath>${project.build.directory}/libs</modulePath>
                    </modulePaths>
                    <addModules>javafx.base,javafx.controls,javafx.fxml,javafx.graphics,javafx.swing,java.base,java.compiler,java.desktop,java.instrument,java.logging,java.management,java.management.rmi,java.naming,java.net.http,java.prefs,java.rmi,java.scripting,java.security.jgss,java.security.sasl,java.sql,java.transaction.xa,java.xml,java.xml.crypto,jdk.attach,jdk.crypto.ec,jdk.crypto.cryptoki,jdk.management,jdk.naming.rmi,jdk.unsupported,jdk.zipfs</addModules>
                    <javaOptions>
                        <option>--add-opens=java.base/java.lang=ALL-UNNAMED</option>
                        <option>--add-opens=java.base/java.util=ALL-UNNAMED</option>
                    </javaOptions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ===== Platform-Profile für Installer-Builds ===== -->
    <profiles>
        <profile>
            <id>windows</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <type>EXE</type>
                            <icon>${project.basedir}/src/main/packaging/bewerbungsmanager.ico</icon>
                            <!-- Diese Kennung darf sich NIE mehr aendern. Ohne sie erzeugt
                                 jpackage bei jedem Bau eine neue, und eine neue Version
                                 installiert sich neben die alte statt sie zu ersetzen. -->
                            <winUpgradeUuid>554e91ea-939b-493c-8933-1c33ea59ce05</winUpgradeUuid>
                            <winDirChooser>true</winDirChooser>
                            <winMenu>true</winMenu>
                            <winShortcut>true</winShortcut>
                            <winShortcutPrompt>true</winShortcutPrompt>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>mac</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <type>DMG</type>
                            <icon>${project.basedir}/src/main/packaging/bewerbungsmanager.icns</icon>
                            <macPackageIdentifier>de.mkysarte.bewerbungsmanager</macPackageIdentifier>
                            <macPackageName>Bewerbungsmanager</macPackageName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>linux</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <type>DEB</type>
                            <icon>${project.basedir}/src/main/packaging/bewerbungsmanager.png</icon>
                            <!-- Debian verlangt eine Betreueradresse; ohne sie steht ein
                                 Platzhalter im Paket. Die noreply-Adresse von GitHub, damit
                                 keine private Anschrift in jedem .deb landet. -->
                            <linuxDebMaintainer>MkySarte@users.noreply.github.com</linuxDebMaintainer>
                            <linuxShortcut>true</linuxShortcut>
                            <linuxMenuGroup>Office</linuxMenuGroup>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
